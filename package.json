{
    "name": "sonicscroll",
    "version": "1.0.0",
    "description": "Lightweight scroll-triggered animation library with audio-aware mode. Zero dependencies, IntersectionObserver-based.",
    "main": "src/sonicscroll.js",
    "module": "src/sonicscroll.js",
    "type": "module",
    "files": [
        "src/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "esbuild src/sonicscroll.js --bundle --minify --format=esm --outfile=dist/sonicscroll.min.js",
        "dev": "esbuild src/sonicscroll.js --bundle --format=esm --outfile=dist/sonicscroll.js --watch"
    },
    "keywords": [
        "scroll",
        "animation",
        "intersection-observer",
        "audio-reactive",
        "sonicmotion"
    ],
    "author": "axscq",
    "license": "MIT",
    "devDependencies": {
        "esbuild": "^0.20.0"
    }
}