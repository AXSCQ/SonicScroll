{
    "name": "sonicscroll",
    "version": "1.0.1",
    "description": "Scroll-triggered animation library with audio-aware mode. IntersectionObserver-based AOS alternative with SonicMotion integration. Zero dependencies.",
    "main": "src/sonicscroll.js",
    "module": "src/sonicscroll.js",
    "type": "module",
    "files": [
        "src/",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "esbuild src/sonicscroll.js --bundle --minify --format=esm --outfile=dist/sonicscroll.min.js",
        "dev": "esbuild src/sonicscroll.js --bundle --format=esm --outfile=dist/sonicscroll.js --watch"
    },
    "keywords": [
        "scroll animation library",
        "scroll triggered animation",
        "AOS alternative",
        "IntersectionObserver animation",
        "animación al hacer scroll",
        "audio-aware scroll effect",
        "sonicmotion plugin",
        "music scroll animation",
        "librería animación scroll JS",
        "scroll reveal animation",
        "scroll fade in library",
        "sonicscroll"
    ],
    "author": "axscq",
    "license": "MIT",
    "devDependencies": {
        "esbuild": "^0.20.0"
    }
}
